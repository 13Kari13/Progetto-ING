									"_parent": {
										"$ref": "AAAAAAGh/3/nooHRmrQ="
									},
									"name": "SCADUTA"
								}
							]
						},
						{
							"_type": "UMLTransition",
							"_id": "AAAAAAGh/4GYWoH0aXE=",
							"_parent": {
								"$ref": "AAAAAAGh/sCl04DDGZw="
							},
							"documentation": "**Transizione:** segnalaAnomalia [NOT isConforme] / DA_SOSTITUIRE\n\n* **Evento:** Rilevazione di guasto, danneggiamento, consumo o simulazione di anomalia (simulaParametro).\n* **Guardia:** Il presidio non soddisfa più i requisiti fisici o quantitativi richiesti (Dotazione.isConforme() == false).\n* **Azione:** Aggiorna l'attributo stato a DA_SOSTITUIRE per richiedere il reintegro.",
							"source": {
								"$ref": "AAAAAAGh/3yseIDliSQ="
							},
